# Copia este archivo como .env en el servidor y cambia cada valor. El archivo .env nunca se sube al repositorio.

# Subdominio que apunta a la IP pública del servidor, sin https://
NEXO_DOMINIO=nexo-ejemplo.duckdns.org

# Genera ambos con: openssl rand -base64 48
NEXO_DB_CLAVE=cambia-esta-clave
NEXO_JWT_SECRETO=cambia-este-secreto-de-al-menos-32-caracteres

# Cuenta del panel web /admin
NEXO_ADMIN_CORREO=admin@ejemplo.com
NEXO_ADMIN_CONTRASENA=cambia-esta-contrasena

# Datos SMTP de Brevo
NEXO_SMTP_HOST=smtp-relay.brevo.com
NEXO_SMTP_PUERTO=587
NEXO_SMTP_USUARIO=usuario-de-brevo
NEXO_SMTP_CLAVE=clave-smtp-de-brevo
NEXO_CORREO_REMITENTE=Nexo <remitente-verificado@ejemplo.com>

# ID del cliente OAuth tipo Web de Google Cloud
NEXO_GOOGLE_CLIENT_ID=000000000000-ejemplo.apps.googleusercontent.com

# Opcional: destino de rclone para guardar las copias fuera del servidor, por ejemplo oracle:nexo-copias
NEXO_COPIAS_DESTINO=
